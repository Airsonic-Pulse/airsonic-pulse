<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

    <changeSet id="add-lyrics-source-last-modified" author="litebito">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="lyrics" columnName="source_last_modified" />
            </not>
        </preConditions>
        <!-- The change signal of the source the cached row was built from: the LRC sidecar's
             mtime for source=file rows, media_file.changed for source=tag rows. Null means
             "signal unknown, refresh once on next request" for file/tag rows and "never
             compare" for user and chartlyrics.com rows, so no backfill is needed. -->
        <addColumn tableName="lyrics">
            <column name="source_last_modified" type="${timestamp_type}">
                <constraints nullable="true" />
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
